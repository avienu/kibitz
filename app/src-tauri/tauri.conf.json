{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kibitz",
  "version": "0.1.1",
  "identifier": "org.kibitzchess.kibitz",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Kibitz",
        "width": 1540,
        "height": 952,
        "minWidth": 1180,
        "minHeight": 760,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Game",
    "shortDescription": "Chess training and database platform",
    "longDescription": "Kibitz is an open-source chess training and database platform: a fast game database, spaced-repetition training, and an explanatory engine that describes positions in human terms.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/avienu/kibitz/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNCMDMyQjIxOERCOTYyODYKUldTR1lybU5JU3NETy91eVhLY0dzMnJ3eklSbEl3SkVaTEpxMVVyalAvNXRUTXJJTnlQc2RZS08K"
    }
  }
}
