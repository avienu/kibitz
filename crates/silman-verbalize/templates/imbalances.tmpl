# imbalances.tmpl — one headline sentence per (kind, magnitude), with
# optional phase-specific overrides keyed `imbalance.<Kind>.<magnitude>.<phase>`.
# Slots: {beneficiary} ("White"/"Black"), {aspect} (from the aspect.* keys).
# Evidence is rendered as separate follow-on sentences (evidence.tmpl) that
# the code appends after the headline.

# Human names for each imbalance aspect (used by balanced/generic templates).
aspect.MinorPieces = the minor pieces
aspect.PawnStructure = pawn structure
aspect.Material = material
aspect.FilesDiagonals = files and diagonals
aspect.SquaresOutposts = squares and outposts
aspect.Space = space
aspect.Development = development
aspect.Initiative = the initiative

imbalance.PawnStructure.minor = {beneficiary}'s pawn structure is a shade healthier.
imbalance.PawnStructure.clear = {beneficiary} has the healthier pawn structure.
imbalance.PawnStructure.winning = {beneficiary}'s structural superiority should win the game.
imbalance.PawnStructure.clear.endgame = In this endgame {beneficiary}'s better pawn structure counts for a great deal.
imbalance.PawnStructure.winning.endgame = In this endgame {beneficiary}'s pawn structure should decide the game.

imbalance.MinorPieces.minor = {beneficiary}'s minor pieces are a touch better placed.
imbalance.MinorPieces.clear = {beneficiary} has the superior minor pieces.
imbalance.MinorPieces.winning = {beneficiary}'s minor pieces dominate the board.

imbalance.Material.minor = {beneficiary} is slightly ahead on material.
imbalance.Material.clear = {beneficiary} is ahead on material.
imbalance.Material.winning = {beneficiary} has a winning material advantage.
imbalance.Material.winning.endgame = In this endgame {beneficiary}'s extra material should decide matters.

imbalance.FilesDiagonals.minor = {beneficiary} has slightly the better of the open lines.
imbalance.FilesDiagonals.clear = {beneficiary} controls the key lines.
imbalance.FilesDiagonals.winning = {beneficiary}'s control of the open lines is overwhelming.

imbalance.SquaresOutposts.minor = {beneficiary} has a small edge in the fight for the key squares.
imbalance.SquaresOutposts.clear = {beneficiary} owns the important squares.
imbalance.SquaresOutposts.winning = {beneficiary}'s grip on the key squares is decisive.

imbalance.Space.minor = {beneficiary} has a little more room to work with.
imbalance.Space.clear = {beneficiary} enjoys a clear space advantage.
imbalance.Space.winning = {beneficiary}'s space advantage is suffocating.

imbalance.Development.minor = {beneficiary} is slightly ahead in development.
imbalance.Development.clear = {beneficiary} is clearly ahead in development.
imbalance.Development.winning = {beneficiary}'s lead in development is decisive.

imbalance.Initiative.minor = {beneficiary} has a slight initiative.
imbalance.Initiative.clear = {beneficiary} has the initiative and is dictating play.
imbalance.Initiative.winning = {beneficiary}'s initiative has reached decisive proportions.

# Balanced verdicts and generic fallbacks.
imbalance.balanced = As for {aspect}, the position is level.
imbalance.generic.minor = {beneficiary} is slightly better in terms of {aspect}.
imbalance.generic.clear = {beneficiary} holds a clear edge in {aspect}.
imbalance.generic.winning = {beneficiary}'s advantage in {aspect} looks decisive.
