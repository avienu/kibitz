# plans.tmpl — plan sentences built from imbalance PlanHints.
# Slots: {side} ("White"/"Black", the side the imbalance favors), {plan}
# (a lowercase verb phrase from the plan.* keys, or the humanized hint
# token), {squares_clause} (empty, or " (key squares: ...)" from the hint).
# The `.more` variants are used for the second and later plans.

plan.lead.side = A good plan for {side}: {plan}{squares_clause}.
plan.lead.side.more = Another idea for {side}: {plan}{squares_clause}.
plan.lead.neutral = A plan worth noting: {plan}{squares_clause}.
plan.lead.neutral.more = Also worth noting: {plan}{squares_clause}.
clause.plan_squares = (key squares: {squares})

# Known plan-hint tokens; unknown tokens are humanized mechanically
# ("BlockadeThenPressure" -> "blockade then pressure").
plan.BlockadeThenPressure = blockade the weak pawn, then pile up on it
plan.OpenThePosition = look for ways to open the position
plan.EscortThePasser = escort the passed pawn up the board with the king
plan.PushThePasser = push the passed pawn
plan.ManeuverKnight = reroute the knight to its best square
plan.TradePieces = seek piece trades to ease the cramped position
plan.PrepareBreak = prepare the freeing pawn break
plan.MinorityAttack = advance the wing pawns in a minority attack
plan.PlayOnQueenside = press forward on the queenside
plan.PlayOnKingside = press forward on the kingside
plan.KeepPositionClosed = keep the position closed, where the knights outshine the bishops
plan.OpenPositionForBishops = open the position so the bishops can breathe
plan.AdvanceQueensideMajority = advance the queenside pawn majority
plan.BlockadeWhitePasser = blockade White's passed pawn
plan.BlockadeBlackPasser = blockade Black's passed pawn
plan.DoubleOnOpenFile = double the heavy pieces on the open file
plan.ManeuverKnightToOutpost = reroute the knight toward the waiting outpost
plan.ManeuverBishopToSupportPoint = walk the bishop round to the support point its own pawn guards
plan.ManeuverRookToOpenFile = bring a rook to the open file
plan.UseSpaceAvoidExchanges = use the extra space and sidestep piece trades
plan.OpenPositionBeforeOpponentCompletes = open the position before the opponent finishes development
plan.WingPawnStormClosedCenter = storm the wing with the pawns; the locked center rules out a counterblow there
plan.RookToSeventh = plant a rook on the seventh rank
plan.RookBehindPasser = put the rook behind the passed pawn
plan.PressureBackwardPawn = pile up on the backward pawn down its half-open file
plan.PressureDoubledPawn = pile up on the front doubled pawn
plan.TradeOrActivateBadBishop = trade off the bad bishop, or reroute it outside the pawn chain
plan.ActivateKingInEndgame = bring the king toward the center; it is a fighting piece now
plan.RestrictKnight = keep denying the enemy knight a stable square
plan.AdvanceCentralMajority = roll the central pawn majority forward
plan.OpenLinesTowardWeakKing = open lines toward the exposed enemy king

# Development prior (run 11): the classical principles as plans.
plan.CompleteDevelopment = finish development — bring the remaining minor pieces off the back rank
plan.CastleIntoSafety = castle and bring the king to safety
plan.ClaimTheCenter = advance a center pawn and stake a claim in the center
plan.QueenAheadOfHerArmy = bring the queen back in step with her army before she is chased with tempo
plan.SamePieceWandering = stop moving the same piece and spend the next move on one still at home

# Composite plans (schema v2): several imbalances converging on one point.
plan.composite.lead = Everything points to {target}: {clauses}.
plan.composite.runner_up = A secondary idea for {side} is to work around {target}.
plan.composite.clause.ManeuverKnightToOutpost = reroute the knight there
plan.composite.clause.ManeuverBishopToSupportPoint = walk the bishop round to it
plan.composite.clause.ManeuverRookToOpenFile = bring a rook to that file
plan.composite.clause.PressureBackwardPawn = pile up on the backward pawn in front of it
plan.composite.clause.BlockadeWhitePasser = blockade the passer on that square
plan.composite.clause.BlockadeBlackPasser = blockade the passer on that square
plan.composite.clause.DoubleOnOpenFile = double the heavy pieces on that file
plan.composite.clause.AdvanceQueensideMajority = advance the pawn majority toward it
plan.composite.clause.KeepPositionClosed = keep the position closed around it
plan.composite.clause.UseSpaceAvoidExchanges = squeeze with the extra space
plan.composite.clause.OpenPositionForBishops = open lines for the bishops toward it
plan.composite.clause.OpenPositionBeforeOpponentCompletes = strike there before the opponent completes development
plan.composite.clause.WingPawnStormClosedCenter = storm that wing with the pawns
plan.composite.clause.RookToSeventh = land a rook on that square
plan.composite.clause.RookBehindPasser = post the rook behind the passer there
plan.composite.clause.PressureDoubledPawn = pile up on the doubled pawn there
plan.composite.clause.TradeOrActivateBadBishop = trade or free the bad bishop standing there
plan.composite.clause.ActivateKingInEndgame = march the king toward it
plan.composite.clause.RestrictKnight = keep the knight there from ever settling
plan.composite.clause.AdvanceCentralMajority = roll the central majority through it
plan.composite.clause.OpenLinesTowardWeakKing = pry open lines toward the king there
plan.composite.clause.MinorityAttack = throw the minority pawns at it
plan.composite.clause.CompleteDevelopment = finish development first
plan.composite.clause.CastleIntoSafety = castle before committing there
plan.composite.clause.ClaimTheCenter = stake the center claim there
plan.composite.clause.QueenAheadOfHerArmy = let the queen fall back in step first
plan.composite.clause.SamePieceWandering = stop walking the same piece

# Candidate-move closing (run 10): {first}/{second} are SAN moves, {n} a
# spelled-out count, {their_plan} a plan verb phrase (base plan.* keys).
suggest.close = Concretely: {first} serves {n} plans at once; {second} is the alternative.
suggest.close.solo = Concretely: {first} serves {n} plans at once.
suggest.close.one = Concretely: {first} advances the main plan; {second} is the alternative.
suggest.close.one.solo = Concretely: {first} advances the main plan.
suggest.prophylactic = Before anything else, deny the opponent: they intend to {their_plan}, and {first} takes that idea off the table.
suggest.count.two = two
suggest.count.three = three
suggest.count.four = four
suggest.count.many = several
